{
  "name": "slotsure",
  "private": true,
  "version": "0.1.0",
  "description": "SlotSure hospital clinic-booking MVP",
  "type": "module",
  "workspaces": ["blacksmith_pro", "apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace blacksmith_pro",
    "dev:web": "npm run dev --workspace blacksmith_pro",
    "dev:api": "npm run dev --workspace @slotsure/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @slotsure/database",
    "db:migrate": "npm run db:migrate --workspace @slotsure/database",
    "db:seed": "npm run db:seed --workspace @slotsure/database"
  },
  "engines": { "node": ">=22.0.0" }
}

{
  "name": "@slotsure/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema.d.ts", "import": "./dist/schema.js", "default": "./dist/schema.js" }
  },
  "scripts": { "build": "tsc -p tsconfig.json", "db:generate": "drizzle-kit generate", "db:migrate": "node --env-file=../../.env --import tsx src/migrate.ts", "db:seed": "node --env-file=../../.env --import tsx src/seed.ts" },
  "dependencies": { "drizzle-orm": "^0.38.3", "postgres": "^3.4.5" },
  "devDependencies": { "drizzle-kit": "^0.30.1", "tsx": "^4.19.2", "typescript": "^5.7.2" }
}
